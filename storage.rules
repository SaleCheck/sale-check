rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // User avatars
    match /users/avatar/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid;
    }

    // Product images
    match /productImages/{productId}/{filename} {
  		allow read, write: if request.auth != null
    										 && firestore.get(/databases/(default)/documents/productsToCheck/$(productId))
         										.data.user == request.auth.uid;
		}

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
