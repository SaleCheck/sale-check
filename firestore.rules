rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for the productsToCheck collection
    match /productsToCheck/{document} {
      // Read allowed if user owns the document
      allow read: if request.auth != null && request.auth.uid == resource.data.user;
      
      // Create: check the new data
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user;
      
      // Update & delete: check the existing data
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.user;
    }
    
    // Rules for the users collection
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
